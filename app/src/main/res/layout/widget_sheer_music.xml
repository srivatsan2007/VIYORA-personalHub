<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sheer_music_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sheer_navy_card"
    android:orientation="horizontal">

    <!-- Left: Duotone Silhouette Art -->
    <FrameLayout
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_sheer_duotone_left">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_headphone_silhouette" />
    </FrameLayout>

    <!-- Right: Track Info & Controls -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/widget_sheer_music_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Shape of You"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_sheer_music_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Ed Sheeran"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Timeline Bar -->
        <ProgressBar
            android:id="@+id/widget_sheer_music_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="35"
            android:progressTint="#5C7CFA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_sheer_music_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="1:24"
                android:textColor="#64748B"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_sheer_music_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="3:54"
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Previous -->
            <TextView
                android:id="@+id/widget_sheer_music_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="⏮"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- Play / Pause -->
            <TextView
                android:id="@+id/widget_sheer_music_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:padding="6dp"
                android:text="▶"
                android:textColor="#5C7CFA"
                android:textSize="20sp" />

            <!-- Next -->
            <TextView
                android:id="@+id/widget_sheer_music_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="⏭"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
