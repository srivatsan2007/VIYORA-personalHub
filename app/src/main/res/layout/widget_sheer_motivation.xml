<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sheer_motivation_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sheer_navy_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_sheer_motivation_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="“Success is not the key to happiness. Happiness is the key to success. If you love what you are doing you will be successful.”"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:id="@+id/widget_sheer_motivation_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:text="— ALBERT SCHWEITZER"
        android:textColor="#5C7CFA"
        android:textSize="10sp"
        android:letterSpacing="0.1" />

</LinearLayout>
