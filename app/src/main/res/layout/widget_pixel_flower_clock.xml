<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pixel_clock_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <AnalogClock
        android:id="@+id/widget_pixel_analog_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:dial="@drawable/ic_pixel_flower_dial"
        android:hand_hour="@drawable/ic_pixel_clock_hand_hour"
        android:hand_minute="@drawable/ic_pixel_clock_hand_minute" />

</FrameLayout>
