<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_nothing_battery_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_nothing_circle_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Red indicator dot -->
    <View
        android:id="@+id/widget_nothing_battery_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="#E11D48" />

    <!-- Battery percentage in stark monospace -->
    <TextView
        android:id="@+id/widget_nothing_battery_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        android:text="64%"
        android:textColor="#FFFFFF"
        android:textSize="32sp" />

    <!-- Status label -->
    <TextView
        android:id="@+id/widget_nothing_battery_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:text="BATTERY"
        android:textColor="#A1A1AA"
        android:textSize="10sp" />

</LinearLayout>
