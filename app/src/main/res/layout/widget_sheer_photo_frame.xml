<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sheer_photo_frame_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sheer_navy_card"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_sheer_photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_viyora_logo"
        android:contentDescription="Photo Memory Frame" />

    <!-- Subtle bottom glass tag -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@drawable/widget_chip_bg"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="MEMORIES"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:letterSpacing="0.1" />

</FrameLayout>
