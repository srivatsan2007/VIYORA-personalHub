<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base deep navy night half -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#0B1220" />
            <stroke
                android:width="2dp"
                android:color="#1A253C" />
        </shape>
    </item>
    <!-- Top day sky half -->
    <item android:bottom="90dp">
        <shape android:shape="oval">
            <solid android:color="#3898EC" />
        </shape>
    </item>
</layer-list>
